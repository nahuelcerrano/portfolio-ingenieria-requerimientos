---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { SITE } from '../../config/site';

export async function getStaticPaths() {
  const trabajos = (await getCollection('trabajos', ({ data }) => !data.borrador)).sort(
    (a, b) => a.data.numero - b.data.numero,
  );
  return trabajos.map((trabajo, i) => ({
    params: { id: trabajo.id },
    props: { trabajo, anterior: trabajos[i - 1], siguiente: trabajos[i + 1] },
  }));
}

const { trabajo, anterior, siguiente } = Astro.props;
const { data } = trabajo;
const { Content } = await render(trabajo);

const pendiente = data.estado === 'pendiente';
const fecha = data.fecha.toLocaleDateString('es-AR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
---

<Layout title={`TP ${data.numero}: ${data.titulo} · ${SITE.autor}`} description={data.descripcion}>
  <Navbar />
  <main class="mx-auto max-w-3xl px-6 pt-28 pb-20">
    <a href="/#trabajos" class="text-sm text-zinc-500 transition-colors hover:text-acento-600 dark:hover:text-acento-300">
      ← Volver a los trabajos
    </a>

    <header class="mt-6">
      <p class="text-sm font-semibold text-acento-600 dark:text-acento-300">
        TP {String(data.numero).padStart(2, '0')} · <span class="capitalize">{data.modalidad}</span> · {pendiente ? 'En preparación' : <time datetime={data.fecha.toISOString()}>{fecha}</time>}
      </p>
      <h1 class="mt-2 text-3xl font-bold tracking-tight text-balance text-zinc-900 sm:text-4xl dark:text-white">
        {data.titulo}
      </h1>
      <p class="mt-4 text-lg text-zinc-600 dark:text-zinc-400">{data.descripcion}</p>

      {
        data.modalidad === 'grupal' && (
          <div class="mt-6 rounded-xl border border-zinc-200 p-4 dark:border-zinc-800">
            <p class="text-sm font-medium text-zinc-900 dark:text-zinc-100">Integrantes del grupo</p>
            <ul class="mt-2 flex flex-wrap gap-2">
              {data.integrantes.map((nombre) => (
                <li class="rounded-md bg-zinc-100 px-2 py-0.5 text-sm text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300">
                  {nombre}
                </li>
              ))}
            </ul>
          </div>
        )
      }

      {
        (data.documento || data.podcast || data.repo || data.demo) && (
          <div class="mt-6 flex flex-wrap gap-3">
            {data.documento && (
              <a href={data.documento} download class="rounded-lg bg-acento-600 px-3 py-1.5 text-sm font-semibold text-white hover:bg-acento-500">
                Descargar documento original
              </a>
            )}
            {data.podcast && (
              <a href={data.podcast} target="_blank" rel="noopener noreferrer" class="rounded-lg border border-zinc-300 px-3 py-1.5 text-sm hover:border-acento-500 dark:border-zinc-700">
                Escuchar el podcast en Spotify
              </a>
            )}
            {data.repo && (
              <a href={data.repo} target="_blank" rel="noopener noreferrer" class="rounded-lg border border-zinc-300 px-3 py-1.5 text-sm hover:border-acento-500 dark:border-zinc-700">
                Repositorio
              </a>
            )}
            {data.demo && (
              <a href={data.demo} target="_blank" rel="noopener noreferrer" class="rounded-lg border border-zinc-300 px-3 py-1.5 text-sm hover:border-acento-500 dark:border-zinc-700">
                Ver demo
              </a>
            )}
          </div>
        )
      }
    </header>

    <Image
      src={data.portada}
      alt={data.portadaAlt}
      width={1280}
      height={720}
      class="mt-10 aspect-video w-full rounded-2xl border border-zinc-200 object-cover dark:border-zinc-800"
    />

    <article class="prose prose-zinc mt-10 max-w-none dark:prose-invert prose-a:text-acento-600 dark:prose-a:text-acento-300 prose-img:rounded-xl">
      <Content />
    </article>

    <nav class="mt-16 grid gap-4 border-t border-zinc-200 pt-8 sm:grid-cols-2 dark:border-zinc-800" aria-label="Otros trabajos">
      {
        anterior ? (
          <a href={`/trabajos/${anterior.id}/`} class="rounded-xl border border-zinc-200 p-4 transition hover:border-acento-500/50 dark:border-zinc-800">
            <span class="text-xs text-zinc-500">← Anterior</span>
            <span class="mt-1 block text-sm font-medium">{anterior.data.titulo}</span>
          </a>
        ) : (
          <span />
        )
      }
      {
        siguiente && (
          <a href={`/trabajos/${siguiente.id}/`} class="rounded-xl border border-zinc-200 p-4 text-right transition hover:border-acento-500/50 dark:border-zinc-800">
            <span class="text-xs text-zinc-500">Siguiente →</span>
            <span class="mt-1 block text-sm font-medium">{siguiente.data.titulo}</span>
          </a>
        )
      }
    </nav>
  </main>
  <Footer />
</Layout>
