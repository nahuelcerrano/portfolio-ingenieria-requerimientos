---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Trabajos from '../components/Trabajos.astro';
import SobreMi from '../components/SobreMi.astro';
import Footer from '../components/Footer.astro';

const trabajos = (await getCollection('trabajos', ({ data }) => !data.borrador)).sort(
  (a, b) => a.data.numero - b.data.numero,
);

const individuales = trabajos.filter((t) => t.data.modalidad === 'individual').length;
const grupales = trabajos.length - individuales;
---

<Layout>
  <Navbar />
  <main>
    <Hero total={trabajos.length} individuales={individuales} grupales={grupales} />
    <Trabajos trabajos={trabajos} />
    <SobreMi />
  </main>
  <Footer />
</Layout>
