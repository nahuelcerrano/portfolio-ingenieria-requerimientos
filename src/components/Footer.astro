---
import { SITE } from '../config/site';

const redes = [
  { href: SITE.github, texto: 'GitHub' },
  { href: SITE.linkedin, texto: 'LinkedIn' },
  { href: `mailto:${SITE.email}`, texto: 'Email' },
];

const anio = new Date().getFullYear();
---

<footer id="contacto" class="border-t border-zinc-200 bg-zinc-50 dark:border-zinc-800 dark:bg-zinc-900/40">
  <div class="mx-auto grid max-w-6xl gap-10 px-6 py-14 sm:grid-cols-2">
    <div>
      <p class="text-lg font-semibold text-zinc-900 dark:text-zinc-100">{SITE.autor}</p>
      <dl class="mt-4 space-y-1 text-sm text-zinc-600 dark:text-zinc-400">
        <div><dt class="inline font-medium">Asignatura:</dt> <dd class="inline">{SITE.materia}</dd></div>
        <div><dt class="inline font-medium">Carrera:</dt> <dd class="inline">{SITE.carrera}</dd></div>
        <div><dt class="inline font-medium">Universidad:</dt> <dd class="inline">{SITE.universidad}</dd></div>
        <div><dt class="inline font-medium">Docente:</dt> <dd class="inline">{SITE.docente}</dd></div>
        <div><dt class="inline font-medium">Cursada:</dt> <dd class="inline">{SITE.cuatrimestre}</dd></div>
      </dl>
    </div>

    <div class="sm:text-right">
      <p class="text-sm font-medium text-zinc-900 dark:text-zinc-100">Contacto</p>
      <ul class="mt-4 flex flex-wrap gap-3 sm:justify-end">
        {
          redes.map(({ href, texto }) => (
            <li>
              <a
                href={href}
                target={href.startsWith('http') ? '_blank' : undefined}
                rel={href.startsWith('http') ? 'noopener noreferrer' : undefined}
                class="rounded-lg border border-zinc-300 px-3 py-1.5 text-sm text-zinc-700 transition hover:border-acento-500 hover:text-acento-600 dark:border-zinc-700 dark:text-zinc-300 dark:hover:text-acento-300"
              >
                {texto}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="border-t border-zinc-200 py-6 text-center text-xs text-zinc-500 dark:border-zinc-800">
    © {anio} {SITE.autor} · Hecho con Astro y Tailwind CSS
  </div>
</footer>
