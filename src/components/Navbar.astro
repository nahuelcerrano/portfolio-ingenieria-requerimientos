---
import { SITE } from '../config/site';

const enlaces = [
  { href: '/#inicio', texto: 'Inicio' },
  { href: '/#trabajos', texto: 'Trabajos' },
  { href: '/#sobre-mi', texto: 'Sobre mí' },
  { href: '/#contacto', texto: 'Contacto' },
];
---

<header
  class="fixed inset-x-0 top-0 z-50 border-b border-zinc-200/70 bg-white/80 backdrop-blur-md dark:border-zinc-800/70 dark:bg-zinc-950/80"
>
  <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-6" aria-label="Principal">
    <a href="/#inicio" class="flex items-center gap-2 font-semibold tracking-tight">
      <span
        class="grid size-8 place-items-center rounded-lg bg-acento-600 text-sm font-bold text-white"
        aria-hidden="true">IR</span
      >
      <span class="hidden sm:inline">{SITE.autor}</span>
    </a>

    <div class="flex items-center gap-1">
      <ul class="hidden items-center gap-1 md:flex">
        {
          enlaces.map(({ href, texto }) => (
            <li>
              <a
                href={href}
                class="rounded-lg px-3 py-2 text-sm text-zinc-600 transition-colors hover:bg-zinc-100 hover:text-zinc-900 dark:text-zinc-400 dark:hover:bg-zinc-900 dark:hover:text-zinc-100"
              >
                {texto}
              </a>
            </li>
          ))
        }
      </ul>

      <button
        type="button"
        data-toggle-tema
        class="grid size-9 place-items-center rounded-lg text-zinc-600 transition-colors hover:bg-zinc-100 hover:text-zinc-900 dark:text-zinc-400 dark:hover:bg-zinc-900 dark:hover:text-zinc-100"
        aria-label="Cambiar entre tema claro y oscuro"
        title="Cambiar tema"
      >
        <!-- Sol (visible en oscuro) -->
        <svg class="hidden size-5 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
        </svg>
        <!-- Luna (visible en claro) -->
        <svg class="size-5 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
        </svg>
      </button>

      <!-- Menú mobile -->
      <button
        type="button"
        id="menu-btn"
        class="grid size-9 place-items-center rounded-lg text-zinc-600 hover:bg-zinc-100 md:hidden dark:text-zinc-400 dark:hover:bg-zinc-900"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="menu-mobile"
      >
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </nav>

  <ul id="menu-mobile" class="hidden border-t border-zinc-200 px-6 py-3 md:hidden dark:border-zinc-800">
    {
      enlaces.map(({ href, texto }) => (
        <li>
          <a
            href={href}
            class="block rounded-lg px-3 py-2 text-sm text-zinc-700 hover:bg-zinc-100 dark:text-zinc-300 dark:hover:bg-zinc-900"
          >
            {texto}
          </a>
        </li>
      ))
    }
  </ul>
</header>

<script>
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('menu-mobile');
  if (btn && menu) {
    const cerrar = () => {
      menu.classList.add('hidden');
      btn.setAttribute('aria-expanded', 'false');
    };
    btn.addEventListener('click', () => {
      const abierto = menu.classList.toggle('hidden') === false;
      btn.setAttribute('aria-expanded', String(abierto));
    });
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', cerrar));
  }
</script>
