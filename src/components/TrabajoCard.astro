---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';

interface Props {
  trabajo: CollectionEntry<'trabajos'>;
}

const { trabajo } = Astro.props;
const { data } = trabajo;

const pendiente = data.estado === 'pendiente';
const fecha = data.fecha.toLocaleDateString('es-AR', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
  timeZone: 'UTC',
});
---

<article
  data-modalidad={data.modalidad}
  class:list={[
    'group relative flex flex-col overflow-hidden rounded-2xl border bg-white transition duration-300 hover:-translate-y-1 hover:border-acento-500/50 hover:shadow-xl hover:shadow-acento-500/5 dark:bg-zinc-900/50',
    pendiente ? 'border-dashed border-zinc-300 dark:border-zinc-700' : 'border-zinc-200 dark:border-zinc-800',
  ]}
>
  <div class="overflow-hidden">
    <Image
      src={data.portada}
      alt={data.portadaAlt}
      width={640}
      height={360}
      class:list={[
        'aspect-video w-full object-cover transition duration-500 group-hover:scale-105',
        pendiente && 'opacity-50 grayscale',
      ]}
    />
  </div>

  <div class="flex flex-1 flex-col p-5">
    <div class="flex items-center justify-between gap-2 text-xs">
      <span class="font-semibold text-acento-600 dark:text-acento-300">
        TP {String(data.numero).padStart(2, '0')}
        {pendiente && <span class="ml-1 rounded-full bg-uai-oro/20 px-2 py-0.5 font-medium text-amber-700 dark:text-uai-oro">En preparación</span>}
      </span>
      <span
        class:list={[
          'rounded-full px-2 py-0.5 font-medium capitalize',
          data.modalidad === 'grupal'
            ? 'bg-acento-400/10 text-acento-600 dark:text-acento-300'
            : 'bg-uai-azul/10 text-uai-azul dark:bg-uai-azul/25 dark:text-sky-300',
        ]}
      >
        {data.modalidad}
      </span>
    </div>

    <h3 class="mt-2 font-semibold text-balance text-zinc-900 dark:text-zinc-100">
      <a href={`/trabajos/${trabajo.id}/`} class="after:absolute after:inset-0 focus:outline-none">
        {data.titulo}
      </a>
    </h3>

    <p class="mt-2 line-clamp-3 text-sm text-zinc-600 dark:text-zinc-400">{data.descripcion}</p>

    {
      data.modalidad === 'grupal' && (
        <p class="mt-3 text-xs text-zinc-500">
          <span class="font-medium">Integrantes:</span> {data.integrantes.join(', ')}
        </p>
      )
    }

    <div class="mt-auto flex flex-wrap items-center gap-1.5 pt-4">
      {
        data.tags.map((tag) => (
          <span class="rounded-md bg-zinc-100 px-2 py-0.5 text-xs text-zinc-600 dark:bg-zinc-800 dark:text-zinc-400">
            {tag}
          </span>
        ))
      }
      {
        pendiente ? (
          <span class="ml-auto text-xs text-zinc-500">Próximamente</span>
        ) : (
          <time datetime={data.fecha.toISOString()} class="ml-auto text-xs text-zinc-500">{fecha}</time>
        )
      }
    </div>
  </div>
</article>
